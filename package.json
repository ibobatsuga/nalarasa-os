{
  "name": "nalarasa-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env --import tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "calibration:sheet": "tsx src/tools/calibration-sheet.ts",
    "odoo:export": "tsx src/tools/odoo-export.ts",
    "test:integration": "node --env-file=.env --test --import tsx test/integration/*.test.ts",
    "pg:dev": "node tools/pg-dev.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.20.0",
    "fastify": "^5.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^22.7.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "description": "Nalarasa OS — multi-tenant ERP for UMKM, restaurants and cafes."
}
